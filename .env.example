# Copy to .env (gitignored) and chmod 600. Values already set in the environment win.
# scripts/run_daily.sh, scripts/rclone_backup.sh, and every Python CLI read this file.

# --- API keys ---
# Twelve Data keys are used in order (key0 -> key1 -> key2); leave unused ones empty.
TWELVE_DATA_API_KEY_1=
TWELVE_DATA_API_KEY_2=
TWELVE_DATA_API_KEY_3=
# Single-key name kept for compatibility (src.fetch_tickers); duplicates of _1.._3 are ignored.
TWELVE_DATA_API_KEY=
FRED_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
DISCORD_WEBHOOK_URL=

# --- Twelve Data ---
# Rotation symbols per run (core symbols are always attempted).
TWELVE_MAX_SYMBOLS=700
# Credits per run across core and rotation (empty: providers.yaml max_credits_per_run).
TWELVE_MAX_CREDITS=1400

# --- Finnhub news ---
# Empty = every active symbol (core symbols first).
FINNHUB_LIMIT=
# First lookback for symbols never fetched (the free plan covers about one year).
FINNHUB_DAYS_BACK=365
FINNHUB_PER_MINUTE=50
FINNHUB_MAX_PAGES=10

# --- FRED ---
# Empty = every series in config/fred_series.txt.
FRED_LIMIT=

# --- Universe refresh (S&P 500 members, NASDAQ list, delisted marks) ---
UNIVERSE_MAX_AGE_DAYS=7

# --- Stage toggles ---
RUN_UNIVERSE=1
RUN_TWELVE=1
RUN_ALPHA_VANTAGE=0
ALPHA_VANTAGE_MAX_SYMBOLS=2
RUN_INDICATORS=1
RUN_FRED=1
RUN_FINNHUB=1
RUN_SUMMARY=1
RUN_DUCKDB_VALIDATE=1
RUN_SNAPSHOT=1
# Rebuild market.db before the full snapshot when it exceeds this factor x its size after the last rebuild.
RUN_DB_REBUILD=1
DB_REBUILD_GROWTH_FACTOR=2
SEND_DISCORD=0
# 1 = plan the run without API calls or state/DB writes.
DRY_RUN=0
# Leave unset to use .venv/bin/python.
# PYTHON_BIN=

# --- rclone backup (off until rclone is configured) ---
RUN_BACKUP=0
RCLONE_DEST=remote:data-scrapping
RCLONE_DRY_RUN=0
BACKUP_MODE=copy
BACKUP_DATA_DIR=data
RCLONE_TRANSFERS=4
RCLONE_CHECKERS=8
