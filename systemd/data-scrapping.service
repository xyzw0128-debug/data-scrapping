# systemd user unit; scripts/install_local.sh replaces @ROOT@ and installs it to ~/.config/systemd/user.
[Unit]
Description=Daily market data collector (data-scrapping)

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
# run_daily.sh loads @ROOT@/.env itself, so no EnvironmentFile is needed.
ExecStart=@ROOT@/scripts/run_daily.sh
Nice=10
