# systemd user unit; scripts/install_local.sh replaces @ROOT@ and installs it to ~/.config/systemd/user.
[Unit]
Description=Back up data-scrapping outputs with rclone

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
# rclone_backup.sh loads @ROOT@/.env and waits for a running collection (pipeline lock).
ExecStart=@ROOT@/scripts/rclone_backup.sh
Nice=10
