[Unit]
Description=Run data-scrapping after the US market close (16:10 New York time, Mon-Fri)

[Timer]
# New York time zone: follows US daylight saving (21:10 UTC in winter, 20:10 UTC in summer).
OnCalendar=Mon..Fri 16:10 America/New_York
# A run missed while the PC was off starts at boot; bars of an unfinished session are not stored.
Persistent=true

[Install]
WantedBy=timers.target
